# =========================================================================
# core-api environment. Copy to .env and fill in. .env is git-ignored.
# In production, inject these via your orchestrator / secret manager.
# =========================================================================

DEV_MODE=False
ENABLE_PERFORMANCE_LOGGER=True

# --- Secrets backend -------------------------------------------------------
# `env`         (default) every secret below is read from this file / the environment.
# `vaultwarden` the 9 managed secrets are fetched at runtime from a self-hosted Vaultwarden via the
#               Bitwarden CLI, and their values below are IGNORED. You still have to inject the three
#               bootstrap secrets some other way — that is the irreducible trade: the vault removes
#               N secrets from this file and adds 3.
# Managed keys: DB_USER DB_PASSWORD REDIS_USER REDIS_USER_PASSWORD SERVICE_TOKEN
#               FILE_PROCESSOR_TOKEN AEROAPI_KEY AVIATION_EDGE_API_KEY AVIATION_EDGE_EXTRA_API_KEY
#               + any key you name an item for below (that is how MS_WEBHOOK_SECRET and
#                 PBIE_CLIENT_SECRET move into the vault; unnamed, they stay env variables)
# Verify a host with:  python tools/check_secrets.py     (prints key -> OK/FAIL, never a value)
# Full guide: docs/secrets.md
SECRETS_BACKEND=env
# BW_SERVER=https://vault.aixii.com
# BW_CLIENTID=user.xxxxxxxx                 # bot account API key — SECRET
# BW_CLIENTSECRET=                          # bot account API key — SECRET
# BW_PASSWORD=                              # bot account master password — SECRET
# BW_CLI_PATH and BW_APPDATA_BASE are already set INSIDE the image (bw 2026.6.0 at
# /usr/local/bin/bw, state on the `bw_state` volume) — only set them for a non-Docker run.
# BW_CLI_PATH=/usr/local/bin/bw
# BW_APPDATA_BASE=/var/lib/aixii/bw         # parent for the per-scope CLI state dirs
# CHECK_SECRETS_ON_BOOT=true                # extra pre-flight vault trip; off by default
# BW_SCOPE=core-api                         # one scope per concurrent process
# NODE_EXTRA_CA_CERTS=/etc/ssl/private-ca.pem   # only if Vaultwarden is behind a private CA
# Item names per key (NON-secret topology, safe to keep here). They override a built-in mapping, and
# for a key that has none they are what puts it in the vault at all. The FIELD is derived from the
# key: a `…_USER` key reads the item's `username`, everything else its `password`.
# BW_ITEM_DB_PASSWORD=aixii-postgres
# BW_ITEM_MS_WEBHOOK_SECRET=ms_graph_webhook
# One login item can hold a whole service principal — name it once for the group:
# BW_ITEM_PBIE=powerbi-capacity      # PBIE_CLIENT_ID=username, PBIE_CLIENT_SECRET=password,
#                                    # PBIE_TENANT_ID=field `tennant_id`, PBIE_SUBSCRIPTION_ID=field
#                                    # `subscription_id`
# BW_FIELD_ is only for a value in a CUSTOM field whose name differs from the default above:
# BW_FIELD_PBIE_TENANT_ID=tenant_id

# --- HTTP server ---
# HOST=0.0.0.0
# PORT=8000
SELF_HOST=api.aixii.com
SELF_PORT=8000
# uvicorn worker processes (1 = single process). Every worker has its own DB pools, see below.
# API_WORKERS=4
# Keep-alive to the reverse proxy, seconds; keep it ABOVE the proxy's upstream keepalive_timeout.
# API_KEEPALIVE_TIMEOUT=65
# How long a validated X-Api-Key is trusted without a DB check (also the revocation lag across workers).
# API_TOKEN_CACHE_SECONDS=10

# --- Shared PostgreSQL cluster (one server for all services) ---
DB_USER=
DB_PASSWORD=
DB_HOST=your-postgres-host
DB_PORT=5432
# core-api OWNS these databases (main DB schema lives in db-contract):
# Two physical databases after the AIXII consolidation (aviation data + infra):
DB_AIXII_NAME=aixii
DB_SERVICE_NAME=service
# Pool per worker PER physical DB: peak connections = API_WORKERS x 2 x (DB_POOL_SIZE + DB_MAX_OVERFLOW).
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE_SECONDS=1800
# A pooled connection idle longer than this gets one `SELECT 1` before reuse.
# DB_PING_IDLE_SECONDS=30

# --- Shared Redis (cache + ARQ broker; MUST be the same Redis for all services) ---
REDIS_USER=
REDIS_USER_PASSWORD=
REDIS_HOST=your-redis-host
REDIS_PORT=6379

# --- Service-to-service token (portal -> this API). Must equal portal CORE_API_TOKEN. ---
SERVICE_TOKEN=

# --- file-processor service (core-api forwards uploaded files here over HTTP) ---
FILE_PROCESSOR_URL=http://file-processor:8000
# must equal file-processor SERVICE_TOKEN
FILE_PROCESSOR_TOKEN=

# --- Power BI Embedded capacity control (Azure ARM; optional feature) ---
# Dedicated control service principal (NOT the embed SPN), provisioned by the azure setup script with a
# narrow read/suspend/resume role. Leave unset to keep the /capacity endpoints disabled (503).
# PBIE_CLIENT_SECRET is a bearer credential for the capacity — inject via secret manager, never commit.
PBIE_TENANT_ID=
PBIE_CLIENT_ID=
PBIE_CLIENT_SECRET=
PBIE_SUBSCRIPTION_ID=
PBIE_RESOURCE_GROUP=
PBIE_CAPACITY_NAME=

# --- API metadata / CORS (defaults applied if unset) ---
# API_TITLE=AIXII API Server
# API_VERSION=v1.0.5a
# API_ROOT_URL=/api/v1
# CORS_ORIGINS=*

# --- Microsoft Graph webhook validation (REQUIRED; same value as external-worker) ---
MS_WEBHOOK_SECRET=

# --- FlightAware AeroAPI (optional; used by _admin/load_history_flightaware.py) ---
# AEROAPI_KEY is sent as the `x-apikey` header. Leave unset if you don't use the AeroAPI loader.
AEROAPI_URL=https://aeroapi.flightaware.com/aeroapi
AEROAPI_KEY=

# --- Migrations on startup (default off; run as a deliberate job instead) ---
# RUN_MIGRATIONS=false
# MIGRATE_DBS=aixii service
